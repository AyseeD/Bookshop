<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    >
    <FlexBox class="adBox" alignItems="Center" wrap="Wrap" >
        <!--Left Side-->
        <VBox class="adLeft">
            <Title class="adText adTitle" text="{i18n>AdTitle}" wrapping="true" />
            <Text class="adText" text="{i18n>AdText}"/>
            
            <HBox class="adEmail">
                <Input placeholder="jane.doe@mail.com"/>
                <Button icon="sap-icon://arrow-right" text="{i18n>AdButton}" />
            </HBox>
        </VBox>

        <!--Right Side-->
        <VBox class="adRight">
            <Image class="adImg" src="{/Books(251)/image}" height="300px"/>
        </VBox>
    </FlexBox>
</core:FragmentDefinition>
