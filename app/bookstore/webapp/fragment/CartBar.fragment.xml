<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="cartPopover"
        title="Cart"
        placement="Bottom">

        <List
            id="cartList"
            items="">

            <CustomListItem>
                <HBox
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    width="100%">

                    <VBox>
                        <Text text="" />
                        <Text text="" />
                    </VBox>

                    <HBox alignItems="Center">
                        <Button
                            icon="sap-icon://less"
                            press=".onDecreaseQuantity"
                            type="Transparent" />

                        <Text
                            text=""
                            class="sapUiTinyMarginBeginEnd" />

                        <Button
                            icon="sap-icon://add"
                            press=".onIncreaseQuantity"
                            type="Transparent" />
                    </HBox>

                </HBox>
            </CustomListItem>

        </List>
    </ResponsivePopover>
</core:FragmentDefinition>