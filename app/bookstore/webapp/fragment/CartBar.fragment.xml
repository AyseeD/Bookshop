<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="cartPopover"
        title="Cart"
        placement="Bottom"
        class="sapUiResponsiveContentPadding">

        <List
            id="cartList"
            items="{/ListOfBooks}">

            <CustomListItem>
                <HBox
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    width="100%">

                    <HBox >
                        <Image src="{image}" width="50px"/>
                        <VBox>
                            <Text text="{title}" />
                            <Text text="{author}" />
                        </VBox>
                    </HBox>

                    <HBox alignItems="Center">
                        <Button
                            icon="sap-icon://less"
                            press=".onDecreaseQuantity"
                            type="Negative" />

                        <Text
                            text=""
                            class="sapUiTinyMarginBeginEnd" />

                        <Button
                            icon="sap-icon://add"
                            press=".onIncreaseQuantity"
                            type="Transparent" />
                    </HBox>

                </HBox>
            </CustomListItem>

        </List>
    </ResponsivePopover>
</core:FragmentDefinition>