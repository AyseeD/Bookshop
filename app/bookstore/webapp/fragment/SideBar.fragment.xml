<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt">
    <VBox id="sideNav" class="sideNav" renderType="Bare" alignItems="Start" height="90%" visible="false">
        <tnt:SideNavigation>
            <tnt:NavigationList id="genreNavList">
            </tnt:NavigationList>

            <tnt:fixedItem>
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="{i18n>NavSettingsTitle}" icon="sap-icon://action-settings" />
                    <tnt:NavigationListItem text="{i18n>NavAccountTitle}" icon="sap-icon://account" />
                </tnt:NavigationList>
            </tnt:fixedItem>
        </tnt:SideNavigation>
    </VBox>
</core:FragmentDefinition>