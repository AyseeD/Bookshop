<mvc:View
    controllerName="booksample.controller.Header"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core">
    <FlexBox class="bookHeader" alignItems="Center">
        <HBox class="headerLeft" alignItems="Center">
            <Button 
                id="headerMenuButton"
                icon="sap-icon://menu2"
                press=".onMenuPress"
            />

            <Button 
                id="headerCollection"
                text="{i18n>CollectionText}"
                class="headerTextNav"
            />

            <Button 
                id="headerTopSelling"
                text="{i18n>TopSellingText}"
                class="headerTextNav"
            />

            <Button 
                id="headerSearchButton"
                icon="sap-icon://search"
            />
        </HBox>

        <HBox class="headerCenter" justifyContent="Center">
            <Text id="headerLogoText" text="{i18n>LogoText}"/>
        </HBox>

        <HBox class="headerRight" alignItems="Center" justifyContent="End">
            <Button 
                id="headerCreateAccount"
                text="{i18n>CreateAccountText}"
                press=".onAccountPress"
            />

            <Button 
                id="headerCartButton"
                icon="sap-icon://cart"
            />
        </HBox>
    </FlexBox>
    <core:Fragment fragmentName="booksample.fragment.SideBar" type="XML" />
</mvc:View>
