<mvc:View
    controllerName="booksample.controller.BookDetail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core">
    <mvc:XMLView viewName="booksample.view.Header" />

    <FlexBox id="bookDetailPage" class="sapUiResponsiveMargin" justifyContent="Center" >
        <HBox id="bookDetailDisplay">
            <Image src="{image}" height="500px"/>

            <VBox>
                <Title text="{title}" titleStyle="H2" />
                <Text text="{author}"/>
                <Text text="{genre}"/>
                <Text text="{descr}" width="200px" />
                <Text text="{stock}"/>
                <Text text="{price}"/>
                <Text text="{currency}"/>
            </VBox>
        </HBox>
    </FlexBox>
</mvc:View>