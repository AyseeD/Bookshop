<mvc:View
    controllerName="booksample.controller.LandingPage"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    >
    <Page class="landingPage" showHeader="false">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo
                rootRole="Region"
                rootLabel="{i18n>LandingPage_rootLabel}"
                contentRole="Main"
                contentLabel="{i18n>LandingPage_contentLabel}"
                headerRole="Banner"
                headerLabel="{i18n>LandingPage_headerLabel}"
            />
        </landmarkInfo>
        <content>
            <core:Fragment fragmentName="booksample.fragment.Header" type="XML"/>
            <core:Fragment fragmentName="booksample.fragment.SideBar" type="XML" />
            <core:Fragment fragmentName="booksample.fragment.Promotion" type="XML"/>
            <mvc:XMLView viewName="booksample.view.GenreList" />
            <mvc:XMLView viewName="booksample.view.BookList" />
            <core:Fragment fragmentName="booksample.fragment.Ad" type="XML"/>
            <core:Fragment fragmentName="booksample.fragment.Footer" type="XML"/>
        </content>
    </Page>
</mvc:View>