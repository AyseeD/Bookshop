<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    >
    <Page showHeader="false">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo
                rootRole="Region"
                rootLabel="{i18n>LandingPage_rootLabel}"
                contentRole="Main"
                contentLabel="{i18n>LandingPage_contentLabel}"
                headerRole="Banner"
                headerLabel="{i18n>LandingPage_headerLabel}"
            />
        </landmarkInfo>
        <content>
            <mvc:XMLView viewName="booksample.view.Header" />
            <mvc:XMLView viewName="booksample.view.Promotion" />
            <mvc:XMLView viewName="booksample.view.GenreList" />
            <mvc:XMLView viewName="booksample.view.BookList" />
        </content>
    </Page>
</mvc:View>