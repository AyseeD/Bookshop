<mvc:View
    controllerName="booksample.controller.BookList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">
    <Carousel 
        pages="{/ListOfBooks}" backgroundDesign="Solid">
        <customLayout>
            <CarouselLayout visiblePagesCount="5" />
        </customLayout>
        <pages >
            <VBox alignItems="Center" justifyContent="Center" class="bookCarousel">
                <Image src="{image}" width="150px"
                    height="220px"
                    densityAware="false"/>

                <Title text="{title}" class="sapUiSmallMarginTop" />
                <Text text="{author}" />
                <Text text="{price} {currency}" />

                <Button icon="sap-icon://arrow-right" press=".onBookListPress" />
            </VBox>
        </pages>
    </Carousel>
</mvc:View>