<mvc:View
    controllerName="booksample.controller.SignUp"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:form="sap.ui.layout.form">
    <FlexBox justifyContent="Center" alignItems="Center" height="100%">
        <VBox class="signUpFormBox" backgroundDesign="Solid">
            <form:SimpleForm class="signUpForm" id="signUpForm"
                editable="true"
                singleContainerFullSize="false"
                ariaLabelledBy="signupTitle">
                    <form:toolbar>
                        <Toolbar id="signupToolbar">
                            <Title id="signupTitle" text="{i18n>SignUpFormTitle}"/>
                        </Toolbar>
                    </form:toolbar>

                    <form:content>
                        <Label text="{i18n>SignUpFormUserNameLabel}" />
                        <Input placeholder="JaneD123" />
                        <Label text="{i18n>SignUpFormFullNameLabel}" />
                        <Input placeholder="Jane"/>
                        <Input placeholder="Doe" />

                        <Label text="{i18n>SignUpFormPasswordLabel}" />
                        <Input placeholder="******"/>
                        <Input placeholder="******" />
                    </form:content>
                </form:SimpleForm>
                <Button  class="signupButton sapUiResponsiveMargin" text="{i18n>SignUpFormSubmitButton}"  accessibleRole="Link" icon="sap-icon://arrow-right" iconFirst="false" press=".onSignUpClick"
                />
        </VBox>
    </FlexBox>
</mvc:View>