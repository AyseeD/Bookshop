<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:cards="sap.f.cards"
    >
    <Carousel
        class="genreCarousel"
        pages="{/ListOfGenres}"
        showPageIndicator="false"
        >
        <customLayout>
            <CarouselLayout visiblePagesCount="6" />
        </customLayout>

        <ScrollContainer
            vertical="false"
            horizontal="false"
            class="sapUiContentPadding">
            <f:Card>
                <f:header>
                    <cards:Header 
                        title="{name}"
                        iconSrc="{icon}"
                    />
                </f:header>
            </f:Card>
        </ScrollContainer>
    </Carousel>
</mvc:View>