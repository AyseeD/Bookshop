@server=http://localhost:4004
@username=a
@password=


### Books
# @name Books_GET
GET {{server}}/browse/Books
Authorization: Basic {{username}}:{{password}}


### Currencies
# @name Currencies_GET
GET {{server}}/browse/Currencies
Authorization: Basic {{username}}:{{password}}


### submitOrder
# @name submitOrder_POST
POST {{server}}/browse/submitOrder
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "book": 201,
  "quantity": 3
}
